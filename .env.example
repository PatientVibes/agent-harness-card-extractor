# Required
AI_GATEWAY_KEY=your-api-key-here

# API endpoint (OpenAI-compatible VLM gateway)
AI_GATEWAY_URL=https://your-gateway.example.com

# Model selection
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
TEXT_MODEL=Qwen/Qwen3-30B-A3B

# Rendering
RENDER_DPI=300
CROP_PAD_PX=10

# VLM parameters
VLM_TEMPERATURE=0.1
EXTRACTION_TEMPERATURE=0.0
DETECTION_CONFIDENCE=0.85

# Review & quality
REVIEW_CONFIDENCE_THRESHOLD=0.7
MAX_RETRY_ATTEMPTS=1

# Concurrency
MAX_CONCURRENT=5

# Paths
WIKI_DIR=./knowledge
REVIEW_QUEUE_DIR=./review_queue
OUTPUT_DIR=./output
